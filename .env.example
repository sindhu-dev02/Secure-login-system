# Copy to .env and fill in. .env is gitignored.

# Signs the session cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# "twilio" sends real SMS through Twilio Verify.
# "console" prints codes to the terminal, so you can develop without an account.
SMS_BACKEND=console

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Set to 1 only when serving over HTTPS (marks the session cookie Secure).
COOKIE_SECURE=0

FLASK_DEBUG=0
